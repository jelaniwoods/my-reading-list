{
  "name": "app",
  "private": true,
  "packageManager": "npm@11.16.0",
  "engines": {
    "node": "24.18.x",
    "npm": "11.16.x"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "esbuild": "^0.28.1",
    "shadcn": "4.21.0",
    "typescript": "7.0.2"
  },
  "scripts": {
    "build": "node script/build-js.mjs",
    "build:css": "npx --no-install @tailwindcss/cli -i ./app/assets/stylesheets/application.tailwind.css -o ./app/assets/builds/application.css --minify",
    "check": "biome check --error-on-warnings app/javascript app/assets/stylesheets && npm run typecheck",
    "check:fix": "biome check --write app/javascript app/assets/stylesheets",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@base-ui/react": "1.8.0",
    "@hotwired/stimulus": "^3.2.2",
    "@hotwired/turbo-rails": "^8.0.23",
    "@tailwindcss/cli": "^4.3.2",
    "basecoat-css": "1.0.2",
    "class-variance-authority": "0.7.1",
    "cn": "0.3.0",
    "date-fns": "4.4.0",
    "lucide-react": "1.47.0",
    "react": "19.3.0",
    "react-day-picker": "10.0.1",
    "react-dom": "19.3.0",
    "sonner": "2.0.8",
    "tailwindcss": "^4.3.2",
    "turbo-mount": "0.4.4",
    "tw-animate-css": "1.4.0"
  },
  "allowScripts": {
    "@parcel/watcher": false,
    "esbuild@0.28.1": true
  }
}
