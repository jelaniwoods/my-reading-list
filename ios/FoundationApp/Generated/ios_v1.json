{
  "settings": {
    "schema_version": 1
  },
  "rules": [
    {
      "patterns": [
        ".*"
      ],
      "properties": {
        "context": "default",
        "pull_to_refresh_enabled": true
      }
    },
    {
      "patterns": [
        "^/books(?:\\?.*)?$"
      ],
      "properties": {
        "presentation": "replace_root"
      }
    }
  ]
}
