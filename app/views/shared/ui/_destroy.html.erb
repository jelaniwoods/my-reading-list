<%# locals: (url:, params: {}, label: t("ui.destroy.label"), title: t("ui.destroy.title"), description: t("ui.destroy.description"), confirm_label: nil, cancel_label: t("ui.cancel"), size: "default", disabled: false) %>
<%= turbo_mount("ConfirmSubmit", props: {title: title, description: description, triggerLabel: label, confirmLabel: confirm_label || label, cancelLabel: cancel_label, size: size, disabled: disabled}) do |controller_name| %>
  <div data-island-fallback>
    <%= button_to url, method: :delete, params: params, disabled: disabled, class: "btn", data: {variant: "ghost", size: size} do %>
      <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="size-4" data-icon="inline-start" aria-hidden="true" focusable="false">
        <path d="M10 11v6" />
        <path d="M14 11v6" />
        <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6" />
        <path d="M3 6h18" />
        <path d="M8 6V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2" />
      </svg>
      <%= label %>
    <% end %>
  </div>
  <%= tag.div "", "data-#{controller_name}-target" => "mount" %>
<% end %>
