<%# locals: (title:, description: nil, action_label: nil, action_path: nil) %>
<div class="empty border border-dashed border-border">
  <header>
    <h2><%= title %></h2>
    <% if description.present? %>
      <p><%= description %></p>
    <% end %>
  </header>
  <% if action_label.present? && action_path.present? %>
    <section><%= link_to action_label, action_path, class: "btn", data: {variant: "outline"} %></section>
  <% end %>
</div>
