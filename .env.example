# Optional application settings. Development works without a .env file.
# Add only the overrides you need to a gitignored .env or .env.development.local.
# dotenv loads these files in development/test; existing process values win.
# Production uses the hosting environment instead (see DEPLOY.md).
# Keep new application settings documented here with placeholders, not secrets.

# Optional PostgreSQL host. Unset uses the normal local/libpq connection settings.
# DB_HOST=localhost

# Connection pool size defaults to RAILS_MAX_THREADS + 5 (8 with the default 3 threads).
# DB_POOL=8

# Solid Cache budget inside the shared database.
# SOLID_CACHE_MAX_SIZE_MB=64

# Solid Queue worker process count (default 1; relevant to a fork-mode supervisor).
# JOB_CONCURRENCY=1

# Production Queue polling intervals in seconds (both default 5).
# Development/test use 0.1 for workers and 1 for dispatchers.
# SOLID_QUEUE_POLL_INTERVAL=5
# SOLID_QUEUE_DISPATCH_INTERVAL=5

# Production Cable polling interval in seconds (default 1).
# Development/test use the async/test adapters instead of Solid Cable.
# SOLID_CABLE_POLL_INTERVAL=1

# Optional production observability. Both integrations are dormant without their keys.
# ROLLBAR_ACCESS_TOKEN=
# SKYLIGHT_AUTHENTICATION=
# Rollbar environment label defaults to the Rails environment.
# ROLLBAR_ENV=production

# Production deployment inputs: you supply DATABASE_URL; Render generates SECRET_KEY_BASE.
# Local development/test have their own database and signing-key defaults.
# DATABASE_URL=
# SECRET_KEY_BASE=

# The Render Blueprint enables in-process jobs; unset otherwise leaves them disabled.
# SOLID_QUEUE_IN_PUMA=true
# Production request timeout in seconds (default 15; also set by the Blueprint).
# RACK_TIMEOUT_SERVICE_TIMEOUT=15

# Puma defaults. Render sets PORT=80 and the other two values below in its Blueprint.
# PORT=3000
# RAILS_MAX_THREADS=3
# WEB_CONCURRENCY=0

# Production log level (default info; also set by the Blueprint).
# RAILS_LOG_LEVEL=info
